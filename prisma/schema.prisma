generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model animales {
  id                                         Int                     @id @default(autoincrement())
  codigo                                     String                  @unique @db.VarChar(30)
  nombre                                     String?                 @db.VarChar(50)
  especie_id                                 Int
  raza_id                                    Int
  genero                                     String                  @db.VarChar(10)
  fecha_nacimiento                           DateTime?               @db.Date
  origen                                     String                  @default("Nacido") @db.VarChar(20)
  fecha_ingreso                              DateTime?               @db.Date
  madre_id                                   Int?
  padre_id                                   Int?
  lote_id                                    Int?
  potrero_id                                 Int?
  estado                                     String?                 @default("Activo") @db.VarChar(20)
  creado_en                                  DateTime?               @default(now()) @db.Timestamp(6)
  especies                                   especies                @relation(fields: [especie_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lotes_animales                             lotes_animales?         @relation(fields: [lote_id], references: [id], onUpdate: NoAction)
  ubicaciones_potreros                       ubicaciones_potreros?   @relation("AnimalPotreroDirecto", fields: [potrero_id], references: [id], onUpdate: NoAction)
  animales_animales_madre_idToanimales       animales?               @relation("animales_madre_idToanimales", fields: [madre_id], references: [id], onUpdate: NoAction)
  other_animales_animales_madre_idToanimales animales[]              @relation("animales_madre_idToanimales")
  animales_animales_padre_idToanimales       animales?               @relation("animales_padre_idToanimales", fields: [padre_id], references: [id], onUpdate: NoAction)
  other_animales_animales_padre_idToanimales animales[]              @relation("animales_padre_idToanimales")
  razas                                      razas                   @relation(fields: [raza_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  alimentacion                               alimentacion[]
  eventos_sanitarios                         eventos_sanitarios[]
  produccion_leche                           produccion_leche[]
  produccion_huevos                          produccion_huevos[]
  registros_peso                             registros_peso[]
  seguimiento_gestacion                      seguimiento_gestacion[] @relation("GestacionAnimal")
  seguimiento_gestacion_como_macho           seguimiento_gestacion[] @relation("GestacionMacho")
  movimientos_ubicacion                      movimientos_ubicacion[]
}

model alimentacion {
  id            Int       @id @default(autoincrement())
  animal_id     Int
  tipo_alimento String    @db.VarChar(50)
  cantidad      Decimal   @db.Decimal(8, 2)
  unidad        String    @db.VarChar(20)
  fecha         DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  creado_en     DateTime? @default(now()) @db.Timestamp(6)
  animales      animales  @relation(fields: [animal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model auditoria {
  id               Int       @id @default(autoincrement())
  usuario_id       Int?
  metodo           String    @db.VarChar(10)
  ruta             String    @db.VarChar(255)
  codigo_respuesta Int?
  fecha            DateTime  @default(now()) @db.Timestamp(6)
}

model balance {
  id           Int       @id @default(autoincrement())
  periodo      DateTime  @db.Date
  total_ventas Decimal   @db.Decimal(10, 2)
  total_gastos Decimal   @db.Decimal(10, 2)
  balance_neto Decimal   @db.Decimal(10, 2)
  creado_en    DateTime? @default(now()) @db.Timestamp(6)
}

model bodega {
  id                Int                @id @default(autoincrement())
  categoria_id      Int
  nombre            String             @db.VarChar(100)
  descripcion       String?            @db.VarChar(150)
  unidad_medida     String             @db.VarChar(20)
  stock_actual      Decimal            @default(0) @db.Decimal(10, 2)
  stock_minimo      Decimal            @default(0) @db.Decimal(10, 2)
  categorias_bodega categorias_bodega  @relation(fields: [categoria_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lotes_inventario  lotes_inventario[]
  movimientos_inventario movimientos_inventario[]
}
model categorias_bodega {
  id     Int      @id @default(autoincrement())
  nombre String   @unique @db.VarChar(50)
  bodega bodega[]
}

model especies {
  id       Int        @id @default(autoincrement())
  nombre   String     @unique @db.VarChar(50)
  animales animales[]
  razas    razas[]
}

model eventos_sanitarios {
  id                           Int                            @id @default(autoincrement())
  animal_id                    Int
  tipo_evento                  String                         @db.VarChar(30)
  dosis_aplicada                Decimal?                      @db.Decimal(6, 2)
  descripcion_tratamiento      String?
  fecha_evento                 DateTime?                      @default(dbgenerated("CURRENT_DATE")) @db.Date
  estado                       String?                        @default("Abierto") @db.VarChar(20)
  via_administracion           String?                        @db.VarChar(30)
  unidad_dosis                 String?                        @db.VarChar(20)
  profesional_responsable      String?                        @db.VarChar(100)
  medicamento                  String?                        @db.VarChar(100)
  fecha_proximo_refuerzo       DateTime?                       @db.Date
  // Auditoria (2026-11-01, mismo patron de produccion_leche/produccion_huevos):
  // quien creo el registro y, si se borro, quien y cuando. `eliminado_en` no
  // nulo = borrado logico -- el registro NUNCA se borra fisicamente (para
  // poder mostrarlo en "Eventos de salud registrados" con la leyenda
  // "Eliminado el ... por ...", igual que el Historial de Produccion).
  creado_por_id                Int?
  eliminado_en                 DateTime?                      @db.Timestamp(6)
  eliminado_por_id             Int?
  animales                     animales                       @relation(fields: [animal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creado_por                   usuarios?                      @relation("EventosSanitariosCreadoPor", fields: [creado_por_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  eliminado_por                usuarios?                      @relation("EventosSanitariosEliminadoPor", fields: [eliminado_por_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  // Auditoria (2026-10-31): Flujo de registro -- a diferencia del patron
  // "ultimo editor" ya usado en produccion/gestacion, acá se necesita un
  // historial de longitud variable (puede haber varias ediciones), por eso
  // es una tabla hija aparte en lugar de columnas en este mismo modelo.
  eventos_sanitarios_historial eventos_sanitarios_historial[]
}

// Auditoria (2026-10-31): una fila por cada accion (Creado / Editado /
// Resuelto) hecha sobre un evento sanitario, con quien la hizo y cuando.
// Ver eventoSanitario.service.ts / eventoSanitario.repository.ts.
model eventos_sanitarios_historial {
  id                   Int                @id @default(autoincrement())
  evento_sanitario_id  Int
  accion               String             @db.VarChar(20)
  usuario_id           Int?
  fecha                DateTime           @default(now()) @db.Timestamp(6)
  eventos_sanitarios   eventos_sanitarios @relation(fields: [evento_sanitario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios             usuarios?          @relation(fields: [usuario_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

model gastos {
  id          Int       @id @default(autoincrement())
  categoria   String    @db.VarChar(30)
  descripcion String?
  monto       Decimal   @db.Decimal(10, 2)
  fecha       DateTime  @db.Date
  creado_en   DateTime? @default(now()) @db.Timestamp(6)
}

model lotes_animales {
  id                   Int                   @id @default(autoincrement())
  nombre               String                @db.VarChar(50)
  potrero_id           Int?
  animales             animales[]
  ubicaciones_potreros ubicaciones_potreros? @relation(fields: [potrero_id], references: [id], onUpdate: NoAction)
  produccion_huevos    produccion_huevos[]
  produccion_leche     produccion_leche[]
}

model lotes_inventario {
  id                  Int      @id @default(autoincrement())
  insumo_id           Int
  numero_lote         String?  @db.VarChar(50)
  fecha_vencimiento   DateTime @db.Date
  cantidad_disponible Decimal  @db.Decimal(10, 2)
  costo_unitario      Decimal  @db.Decimal(10, 2)
  bodega              bodega   @relation(fields: [insumo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model movimientos_ubicacion {
  id                 Int       @id @default(autoincrement())
  animal_id          Int
  potrero_origen_id  Int?
  potrero_destino_id Int?
  fecha              DateTime  @default(now()) @db.Timestamp(6)
  animales           animales  @relation(fields: [animal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model movimientos_inventario {
  id          Int       @id @default(autoincrement())
  insumo_id   Int
  tipo        String    @db.VarChar(20)
  cantidad    Decimal   @db.Decimal(10, 2)
  motivo      String?
  usuario_id  Int?
  fecha       DateTime  @default(now()) @db.Timestamp(6)
  bodega      bodega    @relation(fields: [insumo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios    usuarios? @relation(fields: [usuario_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

model precios_mercado {
  id        Int       @id @default(autoincrement())
  producto  String    @db.VarChar(50)
  precio    Decimal   @db.Decimal(10, 2)
  fecha     DateTime  @db.Date
  creado_en DateTime? @default(now()) @db.Timestamp(6)
}

model produccion_huevos {
  id                Int             @id @default(autoincrement())
  lote_id           Int?
  animal_id         Int?
  cantidad          Int
  cantidad_rotos    Int?            @default(0)
  jornada           String?         @db.VarChar(20)
  observaciones     String?         @db.VarChar(255)
  registrado_en     DateTime?       @default(now()) @db.Timestamp(6)
  // Auditoría (2026-10-01): quién creó el registro y, si se borró, quién y
  // cuándo. `eliminado_en` no nulo = borrado lógico (el registro NUNCA se
  // elimina físicamente de la base de datos, para poder mostrarlo en el
  // historial con la leyenda "Registro eliminado").
  creado_por_id     Int?
  eliminado_en      DateTime?       @db.Timestamp(6)
  eliminado_por_id  Int?
  lotes_animales    lotes_animales? @relation(fields: [lote_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  animales          animales?       @relation(fields: [animal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creado_por        usuarios?       @relation("ProduccionHuevosCreadoPor", fields: [creado_por_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  eliminado_por     usuarios?       @relation("ProduccionHuevosEliminadoPor", fields: [eliminado_por_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

model produccion_leche {
  id                Int              @id @default(autoincrement())
  animal_id         Int?
  lote_id           Int?
  litros            Decimal          @db.Decimal(5, 2)
  jornada           String?          @db.VarChar(20)
  observaciones     String?          @db.VarChar(255)
  registrado_en     DateTime?        @default(now()) @db.Timestamp(6)
  // Auditoría (2026-10-01) — ver comentario en produccion_huevos.
  creado_por_id     Int?
  eliminado_en      DateTime?        @db.Timestamp(6)
  eliminado_por_id  Int?
  animales          animales?        @relation(fields: [animal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lotes_animales    lotes_animales?  @relation(fields: [lote_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creado_por        usuarios?        @relation("ProduccionLecheCreadoPor", fields: [creado_por_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  eliminado_por     usuarios?        @relation("ProduccionLecheEliminadoPor", fields: [eliminado_por_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

model razas {
  id         Int        @id @default(autoincrement())
  especie_id Int
  nombre     String     @db.VarChar(50)
  animales   animales[]
  especies   especies   @relation(fields: [especie_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model registros_peso {
  id            Int       @id @default(autoincrement())
  animal_id     Int
  peso_kg       Decimal   @db.Decimal(6, 2)
  registrado_en DateTime? @default(now()) @db.Timestamp(6)
  animales      animales  @relation(fields: [animal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model reportes_finca {
  id                Int       @id @default(autoincrement())
  tipo_reporte      String    @db.VarChar(50)
  filtros_aplicados Json?
  generado_en       DateTime? @default(now()) @db.Timestamp(6)
}

model roles {
  id         Int        @id @default(autoincrement())
  nombre_rol String     @unique @db.VarChar(50)
  usuarios   usuarios[]
}

model seguimiento_gestacion {
  id                   Int       @id @default(autoincrement())
  animal_id            Int
  macho_id             Int?
  tipo                 String?   @db.VarChar(20)
  fecha_inseminacion   DateTime  @db.Date
  fecha_estimada_parto DateTime  @db.Date
  fecha_real_parto     DateTime? @db.Date
  estado               String?   @default("Pendiente") @db.VarChar(20)
  notas                String?
  // 2026-10-20: fecha real de creacion del registro -- distinta de
  // fecha_inseminacion (esa es la fecha del evento reproductivo, puede
  // registrarse dias despues). Necesaria para la pantalla de detalle.
  creado_en            DateTime? @default(now()) @db.Timestamp(6)
  // Auditoria (2026-10-15): quien hizo cada paso del flujo (crear / confirmar
  // gestacion / cerrar con parto o aborto). Cualquier usuario autenticado puede
  // ejecutar cualquier paso -- no se restringe por rol, solo se deja constancia
  // de quien hizo cada uno. Mismo patron que produccion: los *_id siempre se
  // toman del token de sesion, nunca del body.
  creado_por_id        Int?
  confirmado_por_id    Int?
  confirmado_en        DateTime? @db.Timestamp(6)
  cerrado_por_id       Int?
  cerrado_en           DateTime? @db.Timestamp(6)
  // Auditoria (2026-10-20): soporte de Historial -- mismo patron de borrado
  // logico ya usado en produccion_huevos/produccion_leche. `eliminado_en` no
  // nulo = borrado logico (nunca se borra fisicamente de la BD, para poder
  // mostrarlo despues en el Historial con la leyenda "Registro eliminado").
  // `editado_por_id`/`editado_en` quedan en la ULTIMA edicion de campos (no
  // es un historial de cada cambio, solo "quien edito por ultima vez y cuando").
  editado_por_id       Int?
  editado_en           DateTime? @db.Timestamp(6)
  eliminado_por_id     Int?
  eliminado_en         DateTime? @db.Timestamp(6)
  animales             animales  @relation("GestacionAnimal", fields: [animal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  macho                animales? @relation("GestacionMacho", fields: [macho_id], references: [id], onUpdate: NoAction)
  creado_por           usuarios? @relation("GestacionCreadoPor", fields: [creado_por_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  confirmado_por       usuarios? @relation("GestacionConfirmadoPor", fields: [confirmado_por_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  cerrado_por          usuarios? @relation("GestacionCerradoPor", fields: [cerrado_por_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  editado_por          usuarios? @relation("GestacionEditadoPor", fields: [editado_por_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  eliminado_por        usuarios? @relation("GestacionEliminadoPor", fields: [eliminado_por_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

model ubicaciones_potreros {
  id                 Int              @id @default(autoincrement())
  nombre             String           @db.VarChar(50)
  capacidad_animales Int?
  estado             String?          @default("Disponible") @db.VarChar(20)
  lotes_animales     lotes_animales[]
  animales_directo   animales[]       @relation("AnimalPotreroDirecto")
}

model usuarios {
  id                            Int                 @id @default(autoincrement())
  nombre_usuario                String              @db.VarChar(100)
  correo_electronico            String              @unique @db.VarChar(100)
  telefono                      String?             @db.VarChar(20)
  contrasena                    String              @db.VarChar(255)
  rol_id                        Int
  creado_en                     DateTime?           @default(now()) @db.Timestamp(6)
  estado                        String?             @default("Activo") @db.VarChar(20)
  reset_token                   String?             @db.VarChar(255)
  reset_token_expira            DateTime?           @db.Timestamp(6)
  roles                         roles               @relation(fields: [rol_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  movimientos_inventario        movimientos_inventario[]
  // Auditoría (2026-10-01): registros de producción creados/eliminados por
  // este usuario. Son listas inversas, no agregan columnas a `usuarios`.
  produccion_leche_creada       produccion_leche[]  @relation("ProduccionLecheCreadoPor")
  produccion_leche_eliminada    produccion_leche[]  @relation("ProduccionLecheEliminadoPor")
  produccion_huevos_creada      produccion_huevos[] @relation("ProduccionHuevosCreadoPor")
  produccion_huevos_eliminada   produccion_huevos[] @relation("ProduccionHuevosEliminadoPor")
  // Auditoria (2026-10-15): pasos de seguimiento_gestacion hechos por este usuario.
  gestacion_creada              seguimiento_gestacion[] @relation("GestacionCreadoPor")
  gestacion_confirmada          seguimiento_gestacion[] @relation("GestacionConfirmadoPor")
  gestacion_cerrada             seguimiento_gestacion[] @relation("GestacionCerradoPor")
  // Auditoria (2026-10-20): edicion/borrado logico de seguimiento_gestacion.
  gestacion_editada             seguimiento_gestacion[] @relation("GestacionEditadoPor")
  gestacion_eliminada           seguimiento_gestacion[] @relation("GestacionEliminadoPor")
  // Auditoria (2026-10-31): Flujo de registro de eventos sanitarios (Salud).
  eventos_sanitarios_historial  eventos_sanitarios_historial[]
  // Auditoria (2026-11-01): eventos sanitarios creados/eliminados por este
  // usuario -- mismo patron que produccion_leche/produccion_huevos arriba.
  eventos_sanitarios_creados    eventos_sanitarios[]            @relation("EventosSanitariosCreadoPor")
  eventos_sanitarios_eliminados eventos_sanitarios[]            @relation("EventosSanitariosEliminadoPor")
}

model ventas {
  id              Int       @id @default(autoincrement())
  producto        String    @db.VarChar(50)
  cantidad        Decimal   @db.Decimal(10, 2)
  precio_unitario Decimal   @db.Decimal(10, 2)
  total           Decimal   @db.Decimal(10, 2)
  comprador       String?   @db.VarChar(100)
  fecha           DateTime  @db.Date
  creado_en       DateTime? @default(now()) @db.Timestamp(6)
}
