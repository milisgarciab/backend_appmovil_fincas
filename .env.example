# Copia este archivo como ".env" (sin el ".example") y llena tus valores reales.
# NUNCA subas el archivo ".env" real a GitHub - ya está listado en .gitignore.

# Cadena de conexión con pooling (para la app en runtime)
DATABASE_URL="postgresql://usuario:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Cadena de conexión directa, sin "-pooler" en el host (para migraciones de Prisma)
DIRECT_URL="postgresql://usuario:password@host.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Puerto local del servidor Express
PORT=3000

# Entorno de ejecución
NODE_ENV=development

# Secreto para firmar JWT (definir cuando se implemente el módulo de autenticación)
# JWT_SECRET=
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_SECRET=
# JWT_REFRESH_EXPIRES_IN=7d
